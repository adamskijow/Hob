#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Human-friendly fallback for the native menu-bar controls.
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
USER_HOME="${HOME:?Hob needs a home directory}"
USER_ID="$(id -u)"
SERVICE_TARGET="gui/$USER_ID/com.local.hob"
DOMAIN_TARGET="gui/$USER_ID"
SERVICE_PLIST="$USER_HOME/Library/LaunchAgents/com.local.hob.plist"
LOG_PATH="$USER_HOME/Library/Application Support/Hob/hob.log"

plist_value() {
  local key="$1"
  if [ -f "$SERVICE_PLIST" ]; then
    plutil -extract "$key" raw -o - "$SERVICE_PLIST" 2>/dev/null || true
  fi
}

DATABASE_PATH="${HOB_DB_PATH:-$(plist_value EnvironmentVariables.HOB_DB_PATH)}"
DATABASE_PATH="${DATABASE_PATH:-$USER_HOME/Library/Application Support/Hob/hob.db}"
MODEL_NAME="${HOB_MODEL:-$(plist_value EnvironmentVariables.HOB_MODEL)}"
MODEL_NAME="${MODEL_NAME:-qwen2.5:7b-instruct}"
OLLAMA_ENDPOINT="${HOB_OLLAMA_HOST:-$(plist_value EnvironmentVariables.HOB_OLLAMA_HOST)}"
OLLAMA_ENDPOINT="${OLLAMA_ENDPOINT:-http://localhost:11434}"
ALLOW_REMOTE_OLLAMA="${HOB_ALLOW_REMOTE_OLLAMA:-$(plist_value EnvironmentVariables.HOB_ALLOW_REMOTE_OLLAMA)}"
ALLOW_REMOTE_OLLAMA="${ALLOW_REMOTE_OLLAMA:-0}"
TIMEZONE_NAME="${HOB_TIMEZONE:-$(plist_value EnvironmentVariables.HOB_TIMEZONE)}"
TIMEZONE_NAME="${TIMEZONE_NAME:-UTC}"
UV_PATH="${HOB_UV_PATH:-$(command -v uv || true)}"
UV_PATH="${UV_PATH:-$USER_HOME/.local/bin/uv}"

usage() {
  printf 'usage: scripts/hobctl [status|on|restart|logs|install|pair TELEGRAM_USER_ID]\n'
}

bootstrap_agent() {
  local attempt
  for attempt in {1..100}; do
    if launchctl bootstrap "$DOMAIN_TARGET" "$SERVICE_PLIST" \
      >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  launchctl bootstrap "$DOMAIN_TARGET" "$SERVICE_PLIST"
}

wait_for_running_service() {
  local attempt
  local current_pid=""
  local previous_pid=""
  local stable_checks=0
  local details
  for attempt in {1..60}; do
    details="$(launchctl print "$SERVICE_TARGET" 2>/dev/null || true)"
    current_pid="$(
      printf '%s\n' "$details" |
        /usr/bin/awk '/^[[:space:]]*pid = [0-9]+/ { print $3; exit }'
    )"
    if printf '%s\n' "$details" |
      /usr/bin/grep -q '^[[:space:]]*state = running$' &&
      [ -n "$current_pid" ]; then
      if [ "$current_pid" = "$previous_pid" ]; then
        stable_checks=$((stable_checks + 1))
      else
        stable_checks=1
        previous_pid="$current_pid"
      fi
      if [ "$stable_checks" -ge 4 ]; then
        return 0
      fi
    else
      stable_checks=0
      previous_pid=""
    fi
    sleep 0.5
  done
  printf 'Hob did not reach a stable running state. Check: scripts/hobctl logs\n' >&2
  return 1
}

service_on() {
  if launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; then
    launchctl kickstart "$SERVICE_TARGET"
  elif [ -f "$SERVICE_PLIST" ]; then
    bootstrap_agent
    launchctl kickstart "$SERVICE_TARGET"
  else
    printf 'Hob is not installed. Run: scripts/hobctl install\n' >&2
    return 1
  fi
  wait_for_running_service
  printf 'Hob is on.\n'
}

case "${1:-status}" in
  status)
    if launchctl print "$SERVICE_TARGET" 2>/dev/null |
      /usr/bin/awk '/state = running/ { found = 1 } END { exit !found }'; then
      printf 'Hob background delivery is running.\n'
    elif [ -f "$SERVICE_PLIST" ]; then
      printf 'Hob is installed but not running.\n'
    else
      printf 'Hob is not installed.\n'
    fi
    if [ -z "$UV_PATH" ]; then
      printf 'uv is unavailable; run scripts/hobctl install\n' >&2
      exit 1
    fi
    HOB_DB_PATH="$DATABASE_PATH" \
      HOB_MODEL="$MODEL_NAME" \
      HOB_OLLAMA_HOST="$OLLAMA_ENDPOINT" \
      HOB_ALLOW_REMOTE_OLLAMA="$ALLOW_REMOTE_OLLAMA" \
      HOB_TIMEZONE="$TIMEZONE_NAME" \
      "$UV_PATH" run --directory "$PROJECT_ROOT" python app.py status
    ;;
  on|start)
    service_on
    ;;
  restart)
    if launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; then
      launchctl bootout "$SERVICE_TARGET"
      bootstrap_agent
      wait_for_running_service
      printf 'Hob restarted.\n'
    else
      service_on
    fi
    ;;
  logs)
    if [ ! -f "$LOG_PATH" ]; then
      printf 'Hob has not created a log yet: %s\n' "$LOG_PATH" >&2
      exit 1
    fi
    tail -n 100 -f "$LOG_PATH"
    ;;
  install)
    exec "$PROJECT_ROOT/scripts/install_macos.sh"
    ;;
  pair)
    OWNER_ID="${2:-}"
    case "$OWNER_ID" in
      ''|*[!0-9]*)
        printf 'usage: scripts/hobctl pair TELEGRAM_USER_ID\n' >&2
        exit 2
        ;;
    esac
    WAS_LOADED=0
    if launchctl print "$SERVICE_TARGET" >/dev/null 2>&1; then
      WAS_LOADED=1
      launchctl bootout "$SERVICE_TARGET"
    fi
    if ! HOB_DB_PATH="$DATABASE_PATH" \
      HOB_MODEL="$MODEL_NAME" \
      HOB_OLLAMA_HOST="$OLLAMA_ENDPOINT" \
      HOB_ALLOW_REMOTE_OLLAMA="$ALLOW_REMOTE_OLLAMA" \
      HOB_TIMEZONE="$TIMEZONE_NAME" \
      "$UV_PATH" run --directory "$PROJECT_ROOT" python app.py pair "$OWNER_ID"; then
      if [ "$WAS_LOADED" -eq 1 ]; then
        bootstrap_agent || true
      fi
      exit 1
    fi
    if [ -f "$SERVICE_PLIST" ]; then
      bootstrap_agent
      wait_for_running_service
    fi
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
